{
  "name": "eggyreshub-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "build": "nuxi generate && node scripts/generate-sitemap.mjs && node scripts/sync-fonts.mjs && node scripts/verify-output.mjs",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "postinstall": "nuxi prepare",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.3.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "nuxt": "4.7.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.3",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.104",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.9.10",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.108.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plugin-vuetify": "^2.1.0",
    "vuetify-nuxt-module": "1.0.0-rc.6",
    "wrangler": "^4.158.0"
  }
}
