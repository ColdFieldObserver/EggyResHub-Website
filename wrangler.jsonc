{
  // assets-only Worker：没有 main 字段，纯静态资源，请求不计费。
  // 部署走 Cloudflare Workers Builds：仓库连上 Git 后 main 推送自动部署，
  // 非生产分支 / PR 自动生成预览。CI 只做校验，不手动 wrangler deploy。
  //   build command  = pnpm build       （nuxi generate + sitemap + 字体 + 产物校验）
  //   deploy command = npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eggyreshub-website",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".output/public",
    // 产物是「根页面 xxx.html + 子路径 xxx/index.html」的混合形态：
    // auto-trailing-slash 两种都能命中，URL 保持不带 .html 与尾斜杠。
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "previews": {},
}
